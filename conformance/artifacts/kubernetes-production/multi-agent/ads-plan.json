      {
        "name": "audit-log-export",
        "sourcePath": "$.capabilities.required[9]"
      },
      {
        "name": "human-approval",
        "sourcePath": "$.capabilities.required[10]"
      },
      {
        "name": "policy-decision",
        "sourcePath": "$.capabilities.required[11]"
      },
      {
        "name": "horizontal-scaling",
        "sourcePath": "$.capabilities.required[12]"
      },
      {
