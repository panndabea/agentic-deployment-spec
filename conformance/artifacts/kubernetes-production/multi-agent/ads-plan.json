        "sourcePath": "$.capabilities.required[13]"
      },
      {
        "name": "dead-letter-queue",
        "sourcePath": "$.capabilities.required[14]"
      }
    ],
    "optional": [
      {
        "name": "event-driven-scaling",
        "for": [
          "support-agent"
        ],
        "reason": "scale workers from queue depth when available",
        "sourcePath": "$.capabilities.optional[0]"
      },
      {
        "name": "image-signature-verification",
        "reason": "verify production artifacts before rollout",
        "sourcePath": "$.capabilities.optional[1]"
      }
    ]
  },
  "secrets": [
    {
      "name": "model-api-key",
      "purpose": "model-provider-auth",
      "rotation": "required",
      "source": "external-secret-store",
      "injection": "env",
      "reload": "restart-required",
      "for": [
        "planner-agent",
        "support-agent"
      ],
      "binding": {
        "source": "external-secret-store",
        "ref": "prod/support-agent/model-api-key"
      },
      "bindingAvailable": true,
      "sourcePath": "$.secrets.required[0]",
      "bindingSourcePath": "$.secrets.bindings.model-api-key"
    },
    {
      "name": "database-url",
      "purpose": "session-state",
      "rotation": "required",
      "source": "external-secret-store",
      "injection": "env",
      "reload": "restart-required",
      "for": [
        "orchestrator",
        "planner-agent",
        "tool-server"
      ],
      "binding": {
        "source": "external-secret-store",
        "ref": "prod/support-agent/database-url"
      },
      "bindingAvailable": true,
      "sourcePath": "$.secrets.required[1]",
      "bindingSourcePath": "$.secrets.bindings.database-url"
    },
    {
      "name": "crm-api-token",
      "purpose": "crm-tool-access",
      "rotation": "required",
      "source": "external-secret-store",
      "injection": "runtime-fetch",
      "reload": "hot-reload",
      "for": [
        "tool-server"
      ],
      "binding": {
        "source": "external-secret-store",
        "ref": "prod/customer-ops/crm-api-token"
      },
      "bindingAvailable": true,
      "sourcePath": "$.secrets.required[2]",
      "bindingSourcePath": "$.secrets.bindings.crm-api-token"
    }
  ],
  "networking": {
    "ingress": [
      {
        "name": "public-api",
        "component": "api",
        "port": "http",
        "tls": "required",
        "auth": "required"
      }
    ],
    "internalTraffic": {
    },
    "egress": {
      "default": "deny",
      "allow": [
        "api.openai.com",
        "crm.internal.example",
        "billing.internal.example"
      ]
    },
    "outbound": {
      "default": "deny",
      "allow": [
        "api.openai.com",
        "crm.internal.example",
        "billing.internal.example"
      ]
    },
    "defaultDeny": true,
    "target": {
      "defaultDenyEgress": true,
      "allowedDestinations": [
        "api.openai.com",
        "billing.internal.example",
        "crm.internal.example",
        "internal.crm.example"
      ]
    }
  },
  "security": {
    "sandbox": "restricted",
    "outbound": {
      "default": "deny",
      "allow": [
        "api.openai.com",
        "crm.internal.example",
        "billing.internal.example"
      ]
    },
    "toolPolicy": {
      "default": "deny",
      "allow": [
        "read-ticket",
        "search-knowledge-base",
        "draft-reply",
        "queue-follow-up"
      ],
      "deny": [
        "send-customer-email",
        "update-billing-record"
      ]
    },
    "identity": {
      "serviceAccount": "customer-ops-agents",
      "operatorGroup": "platform-operators"
    },
    "trustBoundaries": [
      {
        "name": "external-users",
        "from": "api",
        "to": "orchestrator"
      },
      {
        "name": "privileged-tools",
        "from": "orchestrator",
        "to": "tool-server"
      }
    ],
    "threatModel": {
      "assets": [
        "customer-support-data",
        "billing-data",
        "session-state",
        "crm-api-token"
      ],
      "actors": [
        "end-user",
        "orchestrator",
        "support-agent",
        "tool-server",
        "platform-operator"
      ],
      "threats": [
        {
          "id": "agent-handoff-confusion",
          "category": "cross-agent-confusion",
          "assets": [
            "customer-support-data",
            "session-state"
          ],
          "mitigations": [
            "explicit-trust-boundaries",
            "orchestration-tracing"
          ]
        },
        {
          "id": "privileged-tool-abuse",
          "category": "unsafe-external-side-effect",
          "assets": [
            "billing-data",
            "crm-api-token"
          ],
          "mitigations": [
            "deny-by-default-tools",
            "approval-gates"
          ]
        }
      ],
      "mitigations": [
        {
          "id": "explicit-trust-boundaries",
          "fields": [
            "security.trustBoundaries"
          ]
        },
        {
          "id": "orchestration-tracing",
          "fields": [
            "observability.traces"
          ]
        },
        {
          "id": "deny-by-default-tools",
          "fields": [
            "security.toolPolicy"
          ]
        },
        {
          "id": "approval-gates",
          "fields": [
            "approvals.required"
          ]
        }
      ],
      "review": {
        "status": "reviewed",
        "reviewedBy": "platform-security",
        "cadence": "release"
      }
    },
    "hardening": {
      "runAsNonRoot": true,
      "readOnlyRootFilesystem": true,
      "seccompProfile": "runtime-default"
    },
    "target": {
      "sandbox": {
        "levels": [
          "restricted",
          "baseline"
        ]
      },
      "toolPolicy": {
        "defaults": [
          "deny",
          "allow"
        ],
        "ruleLists": true
      }
    }
  },
  "approvals": {
    "required": [
      {
        "action": "send-customer-email",
        "mode": "human",
        "reason": "external side effect",
        "scope": {
          "component": "tool-server",
          "dataClass": "customer-communication"
        },
        "auditEvents": [
          "approval_requested",
          "approval_granted",
          "approval_denied"
        ]
      },
      {
        "action": "update-billing-record",
        "mode": "policy-and-human",
        "reason": "privileged financial data mutation",
        "policyDecisionPointRef": "billing-update-policy",
        "scope": {
          "component": "tool-server",
          "dataClass": "billing"
        },
        "auditEvents": [
          "approval_requested",
          "policy_decision_recorded",
          "approval_granted",
          "approval_denied"
        ]
      }
    ],
    "policyDecisionPoints": [
      {
        "name": "billing-update-policy",
        "engineRef": "opa/billing-actions",
        "appliesTo": [
          "update-billing-record"
        ],
        "decisionInputs": [
          "actor",
          "action",
          "dataClass",
          "tenant",
          "amount"
        ],
        "failureMode": "closed",
        "auditEvents": [
          "policy_decision_recorded"
        ]
      }
    ],
    "targetHandlers": {
      "human": {
        "ref": "ticketing/platform-approval"
      },
      "policy": {
        "ref": "opa/agentic-deployment"
      }
    },
    "targetPolicyDecisionPoints": {
      "crm-mutation-policy": {
        "ref": "opa/customer-operations"
      },
      "risk-classification-policy": {
        "ref": "opa/customer-risk"
      },
      "financial-action-policy": {
        "ref": "opa/billing-actions"
      },
      "data-export-policy": {
        "ref": "opa/data-export"
      },
      "session-restore-policy": {
        "ref": "opa/session-state"
      },
      "billing-update-policy": {
        "ref": "opa/billing-actions"
      }
    }
  },
  "observability": {
    "traces": {
      "required": true,
      "format": "opentelemetry"
    },
    "metrics": {
      "required": [
        "request_latency",
        "orchestration_duration",
        "agent_handoff_count",
        "queue_depth",
        "tool_call_count",
        "approval_wait_time",
        "model_cost"
      ]
    },
    "logs": {
      "streams": [
        "api",
        "orchestrator",
        "planner-agent",
        "support-agent",
        "tool-server"
      ],
      "redaction": {
        "required": true
      }
    },
    "auditEvents": {
      "required": [
        "deployment_planned",
        "deployment_applied",
        "tool_call_denied",
        "approval_requested",
        "approval_granted",
        "approval_denied",
        "policy_decision_recorded",
        "secret_resolved"
      ]
    },
    "targetSinks": {
      "traces": {
        "sinks": [
          "opentelemetry-collector"
        ]
      },
      "metrics": {
        "sinks": [
          "prometheus"
        ]
      },
      "auditEvents": {
        "sinks": [
          "security-audit-log"
        ]
      }
    }
  },
  "supplyChain": {
    "requirements": {
    },
    "targetControls": {
      "signatures": {
        "available": true,
        "verifiers": [
          "sigstore-cosign"
        ]
      },
      "sbom": {
        "available": true,
        "formats": [
          "spdx-json",
          "cyclonedx-json"
        ]
      },
      "provenance": {
        "available": true,
        "predicateTypes": [
          "slsa-provenance"
        ]
      }
    }
  },
  "reliability": {
    "rollout": {
      "strategy": "canary",
      "maxUnavailable": 1
    },
    "rollback": {
      "automatic": true,
      "triggers": [
        "elevated_error_rate",
        "failed_readiness"
      ]
    },
    "retries": {
      "default": {
        "attempts": 3,
        "backoff": "exponential",
        "jitter": true
      }
    },
    "deadLetters": {
      "required": true,
      "queue": "customer-ops-dead-letter"
    }
  },
